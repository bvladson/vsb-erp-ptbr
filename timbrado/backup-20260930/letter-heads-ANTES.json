 "Company Letterhead": {
  "content": "<style>\r\n\t/* ======================================================\r\n\t   VSB SOLUÇÕES TÉCNICAS — LETTERHEAD\r\n\t   ====================================================== */\r\n\r\n\t.letter-head {\r\n\t\tmargin: 0 12px 18px 12px !important;\r\n\t\tpadding: 0 !important;\r\n\t}\r\n\r\n\t.letter-head td {\r\n\t\tpadding: 0;\r\n\t}\r\n\r\n\t.vsb-header {\r\n\t\twidth: 100%;\r\n\t\tbackground: #ffffff;\r\n\t\tborder: 1px solid #dce5e8;\r\n\t\tborder-top: 5px solid #063c51;\r\n\t\tborder-radius: 14px;\r\n\t\toverflow: hidden;\r\n\t}\r\n\r\n\t.vsb-header-table {\r\n\t\twidth: 100%;\r\n\t\tborder-collapse: collapse;\r\n\t\ttable-layout: fixed;\r\n\t}\r\n\r\n\t/* =========================\r\n\t   LOGO\r\n\t   ========================= */\r\n\r\n\t.vsb-logo-cell {\r\n\t\twidth: 28%;\r\n\t\tpadding: 18px 18px 18px 22px !important;\r\n\t\tvertical-align: middle;\r\n\t}\r\n\r\n\t.vsb-logo {\r\n\t\twidth: 100%;\r\n\t\tmax-width: 190px;\r\n\t}\r\n\r\n\t.vsb-logo img {\r\n\t\tdisplay: block;\r\n\t\twidth: auto;\r\n\t\tmax-width: 190px;\r\n\t\tmax-height: 72px;\r\n\t\tobject-fit: contain;\r\n\t}\r\n\r\n\t/* =========================\r\n\t   DADOS DA EMPRESA\r\n\t   ========================= */\r\n\r\n\t.vsb-company-cell {\r\n\t\twidth: 39%;\r\n\t\tpadding: 17px 20px !important;\r\n\t\tvertical-align: middle;\r\n\t\tborder-left: 1px solid #e7edef;\r\n\t}\r\n\r\n\t.vsb-company-name {\r\n\t\tcolor: #063c51;\r\n\t\tfont-size: 16px;\r\n\t\tfont-weight: 700;\r\n\t\tline-height: 1.25;\r\n\t\tmargin-bottom: 7px;\r\n\t}\r\n\r\n\t.vsb-company-address {\r\n\t\tcolor: #505f62;\r\n\t\tfont-size: 10px;\r\n\t\tline-height: 1.55;\r\n\t}\r\n\r\n\t.vsb-company-tax {\r\n\t\tmargin-top: 5px;\r\n\t\tcolor: #505f62;\r\n\t\tfont-size: 9.5px;\r\n\t}\r\n\r\n\t/* =========================\r\n\t   DOCUMENTO\r\n\t   ========================= */\r\n\r\n\t.vsb-document-cell {\r\n\t\twidth: 33%;\r\n\t\tbackground: #f4f7f8;\r\n\t\tpadding: 16px 20px !important;\r\n\t\tvertical-align: middle;\r\n\t\tborder-left: 4px solid #b0774c;\r\n\t}\r\n\r\n\t.vsb-document-type {\r\n\t\tcolor: #063c51;\r\n\t\tfont-size: 10px;\r\n\t\tfont-weight: 700;\r\n\t\tletter-spacing: 1.3px;\r\n\t\ttext-transform: uppercase;\r\n\t\tmargin-bottom: 2px;\r\n\t}\r\n\r\n\t.vsb-document-number {\r\n\t\tcolor: #172126;\r\n\t\tfont-size: 15px;\r\n\t\tfont-weight: 700;\r\n\t\tmargin-bottom: 10px;\r\n\t}\r\n\r\n\t.vsb-info-row {\r\n\t\tmargin-top: 3px;\r\n\t\tfont-size: 9.5px;\r\n\t\tline-height: 1.45;\r\n\t}\r\n\r\n\t.vsb-info-label {\r\n\t\tcolor: #7b8589;\r\n\t\tdisplay: inline-block;\r\n\t\tmin-width: 53px;\r\n\t}\r\n\r\n\t.vsb-info-value {\r\n\t\tcolor: #29363b;\r\n\t\tfont-weight: 500;\r\n\t}\r\n\r\n\t/* =========================\r\n\t   CONTATOS\r\n\t   ========================= */\r\n\r\n\t.vsb-contact-bar {\r\n\t\tborder-top: 1px solid #e3eaed;\r\n\t\tpadding: 8px 20px;\r\n\t\tbackground: #ffffff;\r\n\t\tfont-size: 9px;\r\n\t\tcolor: #505f62;\r\n\t}\r\n\r\n\t.vsb-contact-table {\r\n\t\twidth: 100%;\r\n\t\tborder-collapse: collapse;\r\n\t}\r\n\r\n\t.vsb-contact-table td {\r\n\t\tvertical-align: middle;\r\n\t}\r\n\r\n\t.vsb-contact-left {\r\n\t\ttext-align: left;\r\n\t}\r\n\r\n\t.vsb-contact-center {\r\n\t\ttext-align: center;\r\n\t}\r\n\r\n\t.vsb-contact-right {\r\n\t\ttext-align: right;\r\n\t}\r\n\r\n\t.vsb-contact-label {\r\n\t\tcolor: #9a6b49;\r\n\t\tfont-weight: 700;\r\n\t\tmargin-right: 3px;\r\n\t}\r\n\r\n\t/* Impressão / PDF */\r\n\t@media print {\r\n\t\t.vsb-header {\r\n\t\t\tbox-shadow: none !important;\r\n\t\t}\r\n\t}\r\n</style>\r\n\r\n{% set company_info = frappe.db.get_value(\r\n\t\"Company\",\r\n\tdoc.company,\r\n\t[\"company_logo\", \"website\", \"email\", \"phone_no\", \"tax_id\"],\r\n\tas_dict=True\r\n) %}\r\n\r\n{% if doc.company_address %}\r\n\t{% set company_address = frappe.db.get_value(\r\n\t\t\"Address\",\r\n\t\tdoc.company_address,\r\n\t\t[\"address_line1\", \"address_line2\", \"city\", \"state\", \"pincode\", \"country\"],\r\n\t\tas_dict=True\r\n\t) %}\r\n{% elif doc.billing_address %}\r\n\t{% set company_address = frappe.db.get_value(\r\n\t\t\"Address\",\r\n\t\tdoc.billing_address,\r\n\t\t[\"address_line1\", \"address_line2\", \"city\", \"state\", \"pincode\", \"country\"],\r\n\t\tas_dict=True\r\n\t) %}\r\n{% endif %}\r\n\r\n{% set doc_date = doc.get(\"transaction_date\") or doc.get(\"posting_date\") %}\r\n\r\n{% if doc.doctype == \"Quotation\" %}\r\n\t{% set document_label = \"ORÇAMENTO\" %}\r\n{% elif doc.doctype == \"Sales Order\" %}\r\n\t{% set document_label = \"PEDIDO DE VENDA\" %}\r\n{% elif doc.doctype == \"Sales Invoice\" %}\r\n\t{% set document_label = \"NOTA / FATURA\" %}\r\n{% else %}\r\n\t{% set document_label = doc.doctype %}\r\n{% endif %}\r\n\r\n\r\n<div class=\"vsb-header\">\r\n\r\n\t<table class=\"vsb-header-table\">\r\n\t\t<tbody>\r\n\t\t\t<tr>\r\n\r\n\t\t\t\t<!-- LOGO -->\r\n\t\t\t\t<td class=\"vsb-logo-cell\">\r\n\r\n\t\t\t\t\t{% if company_info and company_info.company_logo %}\r\n\r\n\t\t\t\t\t<div class=\"vsb-logo\">\r\n\t\t\t\t\t\t<img\r\n\t\t\t\t\t\t\tsrc=\"{{ frappe.utils.get_url(company_info.company_logo) }}\"\r\n\t\t\t\t\t\t\talt=\"{{ doc.company }}\"\r\n\t\t\t\t\t\t>\r\n\t\t\t\t\t</div>\r\n\r\n\t\t\t\t\t{% endif %}\r\n\r\n\t\t\t\t</td>\r\n\r\n\r\n\t\t\t\t<!-- EMPRESA -->\r\n\t\t\t\t<td class=\"vsb-company-cell\">\r\n\r\n\t\t\t\t\t<div class=\"vsb-company-name\">\r\n\t\t\t\t\t\t{{ doc.company }}\r\n\t\t\t\t\t</div>\r\n\r\n\t\t\t\t\t{% if company_address %}\r\n\r\n\t\t\t\t\t<div class=\"vsb-company-address\">\r\n\r\n\t\t\t\t\t\t{% if company_address.address_line1 %}\r\n\t\t\t\t\t\t\t{{ company_address.address_line1 }}\r\n\t\t\t\t\t\t{% endif %}\r\n\r\n\t\t\t\t\t\t{% if company_address.address_line2 %}\r\n\t\t\t\t\t\t\t<br>{{ company_address.address_line2 }}\r\n\t\t\t\t\t\t{% endif %}\r\n\r\n\t\t\t\t\t\t{% if company_address.city %}\r\n\t\t\t\t\t\t\t<br>{{ company_address.city }}\r\n\t\t\t\t\t\t{% endif %}\r\n\r\n\t\t\t\t\t\t{% if company_address.state %}\r\n\t\t\t\t\t\t\t- {{ company_address.state }}\r\n\t\t\t\t\t\t{% endif %}\r\n\r\n\t\t\t\t\t\t{% if company_address.pincode %}\r\n\t\t\t\t\t\t\t&nbsp; • &nbsp;CEP {{ company_address.pincode }}\r\n\t\t\t\t\t\t{% endif %}\r\n\r\n\t\t\t\t\t</div>\r\n\r\n\t\t\t\t\t{% endif %}\r\n\r\n\r\n\t\t\t\t\t{% if company_info and company_info.tax_id %}\r\n\t\t\t\t\t<div class=\"vsb-company-tax\">\r\n\t\t\t\t\t\tCNPJ: {{ company_info.tax_id }}\r\n\t\t\t\t\t</div>\r\n\t\t\t\t\t{% endif %}\r\n\r\n\t\t\t\t</td>\r\n\r\n\r\n\t\t\t\t<!-- DOCUMENTO -->\r\n\t\t\t\t<td class=\"vsb-document-cell\">\r\n\r\n\t\t\t\t\t<div class=\"vsb-document-type\">\r\n\t\t\t\t\t\t{{ document_label }}\r\n\t\t\t\t\t</div>\r\n\r\n\t\t\t\t\t<div class=\"vsb-document-number\">\r\n\t\t\t\t\t\t{{ doc.name }}\r\n\t\t\t\t\t</div>\r\n\r\n\r\n\t\t\t\t\t{% if doc_date %}\r\n\t\t\t\t\t<div class=\"vsb-info-row\">\r\n\t\t\t\t\t\t<span class=\"vsb-info-label\">\r\n\t\t\t\t\t\t\tEmissão:\r\n\t\t\t\t\t\t</span>\r\n\r\n\t\t\t\t\t\t<span class=\"vsb-info-value\">\r\n\t\t\t\t\t\t\t{{ frappe.utils.formatdate(doc_date, \"dd/MM/yyyy\") }}\r\n\t\t\t\t\t\t</span>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t\t{% endif %}\r\n\r\n\r\n\t\t\t\t\t{% if doc.get(\"valid_till\") %}\r\n\t\t\t\t\t<div class=\"vsb-info-row\">\r\n\r\n\t\t\t\t\t\t<span class=\"vsb-info-label\">\r\n\t\t\t\t\t\t\tValidade:\r\n\t\t\t\t\t\t</span>\r\n\r\n\t\t\t\t\t\t<span class=\"vsb-info-value\">\r\n\t\t\t\t\t\t\t{{ frappe.utils.formatdate(doc.valid_till, \"dd/MM/yyyy\") }}\r\n\t\t\t\t\t\t</span>\r\n\r\n\t\t\t\t\t</div>\r\n\t\t\t\t\t{% endif %}\r\n\r\n\t\t\t\t</td>\r\n\r\n\t\t\t</tr>\r\n\t\t</tbody>\r\n\t</table>\r\n\r\n\r\n\t<!-- CONTATOS -->\r\n\t<div class=\"vsb-contact-bar\">\r\n\r\n\t\t<table class=\"vsb-contact-table\">\r\n\t\t\t<tbody>\r\n\t\t\t\t<tr>\r\n\r\n\t\t\t\t\t<td class=\"vsb-contact-left\">\r\n\r\n\t\t\t\t\t\t{% if company_info and company_info.website %}\r\n\r\n\t\t\t\t\t\t\t<span class=\"vsb-contact-label\">\r\n\t\t\t\t\t\t\t\tSITE\r\n\t\t\t\t\t\t\t</span>\r\n\r\n\t\t\t\t\t\t\t{{ company_info.website }}\r\n\r\n\t\t\t\t\t\t{% endif %}\r\n\r\n\t\t\t\t\t</td>\r\n\r\n\r\n\t\t\t\t\t<td class=\"vsb-contact-center\">\r\n\r\n\t\t\t\t\t\t{% if company_info and company_info.email %}\r\n\r\n\t\t\t\t\t\t\t<span class=\"vsb-contact-label\">\r\n\t\t\t\t\t\t\t\tE-MAIL\r\n\t\t\t\t\t\t\t</span>\r\n\r\n\t\t\t\t\t\t\t{{ company_info.email }}\r\n\r\n\t\t\t\t\t\t{% endif %}\r\n\r\n\t\t\t\t\t</td>\r\n\r\n\r\n\t\t\t\t\t<td class=\"vsb-contact-right\">\r\n\r\n\t\t\t\t\t\t{% if company_info and company_info.phone_no %}\r\n\r\n\t\t\t\t\t\t\t<span class=\"vsb-contact-label\">\r\n\t\t\t\t\t\t\t\tCONTATO\r\n\t\t\t\t\t\t\t</span>\r\n\r\n\t\t\t\t\t\t\t{{ company_info.phone_no }}\r\n\r\n\t\t\t\t\t\t{% endif %}\r\n\r\n\t\t\t\t\t</td>\r\n\r\n\t\t\t\t</tr>\r\n\t\t\t</tbody>\r\n\t\t</table>\r\n\r\n\t</div>\r\n\r\n</div>",
